<launch>
      <arg name="mass"  value="400"/>
      <arg name="drone_id" value = "1"/>
      <arg name="uav_num" value="1"/>
      <arg name="use_uav_extra_model" value = "0"/>
      <arg name="init_x" value="-5.0"/>
      <arg name="init_y" value="0.0"/>
      <arg name="init_z" value="4.0"/> 
      <arg name="map_size_x_"/>
      <arg name="map_size_y_"/>
      <arg name="map_size_z_"/>
      <arg name="c_num"/>
      <arg name="p_num"/>
      <arg name="min_dist"/>
      <arg name="downsample_resolution"/>
      <arg name="odometry_topic"/>
      <arg name="map_name"/>
  <!-- There are two kinds of maps you can choose, just comment out the one you don’t need like the follow. Have a try. /-->

      <node pkg="map_generator" name="map_pub" type="map_pub" output="screen"
            args="$(arg map_name)">
            <param name="add_boundary" value="0"/>
            <param name="is_bridge" value="0"/>
            <param name="downsample_res" value="$(arg downsample_resolution)"/>         
            <param name="map_offset_x" value="0.0"/>   
            <param name="map_offset_y" value="0.0"/>   
            <param name="map_offset_z" value="0.0"/>   
      </node>

      <node pkg="crane_aero_sim" name="coaxial_dynamics_$(arg drone_id)" type="crane_control_node" output="screen">
            <remap from="~odom" to="/coaxial_$(arg drone_id)/simulator/odom"/>
            <remap from="~cmd_rpm" to="/planning/pos_cmd"/>
            <param name="mass"   value="$(arg mass)"/>
            <param name="simulation_rate"   value="200"/>
            <param name="coaxial_name"   value="coaxial_x8_$(arg drone_id)"/>
            <param name="init_state_x"   value="$(arg init_x)"/>
            <param name="init_state_y"   value="$(arg init_y)"/>
            <param name="init_state_z"   value="$(arg init_z)"/>
            <param name="enable_rc"      value="false"/>   <!-- 遥控器总开关：true=接收 /joy；false=忽略遥控器，启动即等待指令 -->
      </node>

      <node pkg="crane_aero_sim" name="visualizer_node" type="visualizer_node" output="screen">
            <remap from="~odom" to="/coaxial_$(arg drone_id)/simulator/odom"/>
            <remap from="~cmd_rpm" to="/planning/pos_cmd"/>
            <rosparam file="$(find crane_aero_sim)/config/visualizer_config.yaml" command="load" />
      </node>
 
